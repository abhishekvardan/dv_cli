{
  "name": "@abhishekvardanbotta/dv",
  "version": "0.10.0",
  "description": "One CLI and MCP server for GitHub, Vercel, Supabase, Gmail, Calendar and LinkedIn - with OAuth built in, an undo journal, and cross-service workflows.",
  "type": "module",
  "bin": {
    "dv": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SKILL.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync-plugin": "node scripts/sync-plugin.mjs",
    "prepublishOnly": "npm run sync-plugin && npm run build"
  },
  "keywords": [
    "cli",
    "github",
    "vercel",
    "gmail",
    "linkedin",
    "oauth",
    "devops",
    "deploy",
    "workflow",
    "mcp",
    "mcp-server",
    "claude-code",
    "supabase"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@abhishekvardanbotta/kiln": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "@abhishekvardanbotta/kiln": {
      "optional": true
    }
  },
  "author": "Abhishek Vardan Botta",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
